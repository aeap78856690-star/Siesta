/**
 * Orden: Gemini → IA de respaldo → LocalResponder (offline).
 */
class AIManager(
    private val context: Context,
    private val geminiClient: GeminiClient,
    private val backupClient: BackupAIClient,
    private val localResponder: LocalResponder
) {

    enum class Provider { GEMINI, BACKUP, LOCAL }

    suspend fun chat(userMessage: String): String = withContext(Dispatchers.IO) {
        val hasInternet = isInternetAvailable()

        if (hasInternet && geminiClient.hasValidKey()) {
            try {
                val r = geminiClient.chat(userMessage)
                if (r.isNotBlank()) return@withContext r
            } catch (_: Exception) { }
        }

        if (hasInternet && backupClient.hasValidKey()) {
            try {
                val r = backupClient.chat(userMessage)
                if (r.isNotBlank()) return@withContext r
            } catch (_: Exception) { }
        }

        localResponder.reply(userMessage)
    }

    suspend fun chatWith(provider: Provider, userMessage: String): String =
        withContext(Dispatchers.IO) {
            when (provider) {
                Provider.GEMINI -> {
                    if (!isInternetAvailable() || !geminiClient.hasValidKey())
                        return@withContext "Gemini no está disponible... (sin internet o sin API key)."
                    try { geminiClient.chat(userMessage) }
                    catch (e: Exception) { "Error con Gemini: ${e.message}" }
                }
                Provider.BACKUP -> {
                    if (!isInternetAvailable() || !backupClient.hasValidKey())
                        return@withContext "La IA de respaldo no está disponible..."
                    try { backupClient.chat(userMessage) }
                    catch (e: Exception) { "Error con el respaldo: ${e.message}" }
                }
                Provider.LOCAL -> localResponder.reply(userMessage)
            }
        }

    fun getStatus(): String {
        val internet = if (isInternetAvailable()) "✅ Con internet" else "❌ Sin internet"
        val gemini = if (geminiClient.hasValidKey()) "✅ Gemini configurado" else "❌ Gemini sin API key"
        val backup = if (backupClient.hasValidKey()) "✅ Respaldo configurado" else "❌ Respaldo sin API key"
        return """
            |Estado de las IAs:
            |
            |$internet
            |$gemini
            |$backup
            |
            |Orden de uso:
            |1. Gemini (principal)
            |2. IA de respaldo
            |3. Modo offline
        """.trimMargin()
    }

    private fun isInternetAvailable(): Boolean {
        val cm = context.getSystemService(Context.CONNECTIVITY_SERVICE) as ConnectivityManager
        val network = cm.activeNetwork ?: return false
        val caps = cm.getNetworkCapabilities(network) ?: return false
        return caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET) &&
            caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_VALIDATED)
    }
}
